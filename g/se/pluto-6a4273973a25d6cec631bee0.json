[{"s":1795283748,"e":1795286868,"t":"Star Trek: Voyager: Cathexis","st":"Cathexis","d":"An encounter with a strange nebula leaves Chakotay brain-dead and the crew battling a powerful force that seems to be taking over their minds.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E13"},{"s":1795286868,"e":1795289988,"t":"Star Trek: Voyager: Faces","st":"Faces","d":"Voyager's half-human, half-Klingon Chief Engineer Torres is split into two beings by a scientist desperate to cure the plague that's destroying his people.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E14"},{"s":1795289988,"e":1795293108,"t":"Star Trek: Voyager: Jetrel","st":"Jetrel","d":"A painful chapter in Neelix's past is reopened when the man responsible for killing his family beams aboard Voyager.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E15"},{"s":1795293108,"e":1795296228,"t":"Star Trek: Voyager: Learning Curve","st":"Learning Curve","d":"Tuvok incurs the wrath of Maquis crewmembers when he's put in charge of a \"boot camp\" designed to bring them up to Starfleet standards.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E16"},{"s":1795296228,"e":1795299348,"t":"Star Trek: Voyager: The 37's","st":"The 37's","d":"The crew explores a remote planet inhabited by humans who were abducted by aliens in 1937","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E01"},{"s":1795299348,"e":1795302468,"t":"Star Trek: Voyager: Initiations","st":"Initiations","d":"Chakotay faces an unlikely enemy: a Kazon boy who hopes to achieve warrior status by killing him.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E02"},{"s":1795302468,"e":1795305588,"t":"Star Trek: Voyager: Projections","st":"Projections","d":"The ship's holographic doctor experiences a world where illusion and reality collide.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E03"},{"s":1795305588,"e":1795308708,"t":"Star Trek: Voyager: Elogium","st":"Elogium","d":"The ship is surrounded by creatures whose presence accelerates Kes’ reproductive process and threatens Voyager's key operating systems.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E04"},{"s":1795308708,"e":1795311828,"t":"Star Trek: Voyager: Non Sequitur","st":"Non Sequitur","d":"Ensign Harry Kim awakens on Earth, where he's shocked to learn there's no record of his assignment on Voyager.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E05"},{"s":1795311828,"e":1795314948,"t":"Star Trek: Voyager: Twisted","st":"Twisted","d":"A strange spatial distortion afflicts the ship and has the entire crew literally lost on their own ship.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E06"},{"s":1795314948,"e":1795318068,"t":"Star Trek: Voyager: Parturition","st":"Parturition","d":"Neelix and Paris must put aside their romantic rivalry over Kes after they crash-land on a toxic planet.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E07"},{"s":1795318068,"e":1795321188,"t":"Star Trek: Voyager: Persistence Of Vision","st":"Persistence Of Vision","d":"A mysterious force puts the crew in a delusional state that causes their most deeply buried thoughts and desires to surface.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E08"},{"s":1795321188,"e":1795324308,"t":"Star Trek: Voyager: Tattoo","st":"Tattoo","d":"Chakotay is stranded on a planet inhabited by natives with ties to his ancestors.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E09"},{"s":1795324308,"e":1795327428,"t":"Star Trek: Voyager: Cold Fire","st":"Cold Fire","d":"Kes makes contact with Ocampa spacefarers and the female Caretaker, who may have the power to send the crew home.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E10"},{"s":1795327428,"e":1795330548,"t":"Star Trek: Voyager: Maneuvers","st":"Maneuvers","d":"The theft of a transporter module by Kazon forces thrusts Chakotay into an explosive confrontation with his traitorous former lover Seska.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E11"},{"s":1795330548,"e":1795333668,"t":"Star Trek: Voyager: Resistance","st":"Resistance","d":"Janeway must escape from a city under siege by the Mokra, a brutal regime determined to crush the growing resistance movement against it.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E12"},{"s":1795333668,"e":1795336788,"t":"Star Trek: Voyager: Prototype","st":"Prototype","d":"After Torres reactivates a humanoid robot, she's drawn into a war between robotic enemies.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E13"},{"s":1795336788,"e":1795339908,"t":"Star Trek: Voyager: Alliances","st":"Alliances","d":"Hoping to strengthen Voyager's strategic position in the quadrant, Janeway reluctantly seeks an alliance with the Kazon.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E14"},{"s":1795339908,"e":1795343028,"t":"Star Trek: Voyager: Threshold","st":"Threshold","d":"Paris makes history by becoming the first person to cross the transwarp threshold, but could pay for the achievement with his life.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E15"}]