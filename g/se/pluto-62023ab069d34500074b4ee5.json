[{"s":1795282506,"e":1795285762,"t":"Doctor Who","st":"Den hungriga jorden","d":"Doktorn, Amy och Rory har landat i en nära framtid i en liten walesisk by. Det är vackert, men faran lurar.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/67ab3bc07595d89db74be99f/tile_1768039123928.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E08"},{"s":1795285762,"e":1795289162,"t":"Doctor Who","st":"Kallt blod","d":"Doktorn kämpar för att förhindra krig mellan Silurians och människorna. Men en möjlig apokalyps hotar.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/67ab3bc07595d89db74be99f/tile_1768039123928.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E09"},{"s":1795289162,"e":1795292618,"t":"Doctor Who","st":"Vincent och Doktorn","d":"Doktorn och Amy lär sig mera om skräckens konst i detta nya äventyr där de träffar Vincent Van Gogh.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/67ab3bc07595d89db74be99f/tile_1768039123928.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E10"},{"s":1795292618,"e":1795295769,"t":"Doctor Who","st":"Hyresgästen","d":"I ett hus på Aickman Road finns en trappa som folk går uppför men aldrig kommer ner ifrån.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/67ab3bc07595d89db74be99f/tile_1768039123928.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E11"},{"s":1795295769,"e":1795299350,"t":"Doctor Who","st":"Pandorica öppnas","d":"Den mest fruktade varelsen i hela kosmos är på väg. Kan Doktorn stoppa den?","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/67ab3bc07595d89db74be99f/tile_1768039123928.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E12"},{"s":1795299350,"e":1795303288,"t":"Doctor Who","st":"Den stora smällen","d":"Doktorn är borta, Tardis har förstörts och universum rasar samman. Det enda hoppet är en liten flicka.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/67ab3bc07595d89db74be99f/tile_1768039123928.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E13"},{"s":1795303288,"e":1795306582,"t":"Doctor Who","st":"Den omöjliga astronauten","d":"Doktorn, Amy och Rory befinner sig i Ovala rummet år 1969 där de måste rädda en skräckslagen liten flicka.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/67ab3bc07595d89db74be99f/tile_1768039123928.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S06E01"},{"s":1795306582,"e":1795310028,"t":"Doctor Who","st":"Månens dag","d":"Med hjälp av president Nixon och Neil Armstrong inleder Doktorn ett uppror mot en invasion av utomjordingar.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/67ab3bc07595d89db74be99f/tile_1768039123928.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S06E02"},{"s":1795310028,"e":1795313401,"t":"Doctor Who","st":"Black Spots förbannelse","d":"TARDIS har hamnat ombord på ett piratskepp från 1600-talet vars besättning blir lurade in i döden.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/67ab3bc07595d89db74be99f/tile_1768039123928.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S06E03"},{"s":1795313401,"e":1795316686,"t":"Doctor Who","st":"Rebellköttet","d":"En soltsunami får TARDIS att störta mot en fabrik på jorden där mänskliga dubbelgångare används.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/67ab3bc07595d89db74be99f/tile_1768039123928.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S06E05"},{"s":1795316686,"e":1795320080,"t":"Doctor Who","st":"Nästanfolket","d":"Medan solstormen rasar och fabriken faller sönder vill en dubbelgångare som drivits till vansinne hämnas.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/67ab3bc07595d89db74be99f/tile_1768039123928.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=7