[{"s":1795848204,"e":1795851306,"t":"Andromeda","st":"La simmetria dell'imperfezione","d":"Quando Rommie diventa troppo emotiva, la nave le nega l'accesso per eseguire la diagnostica.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670666589_8_20260304T004228246Z_87_imageprocessorclient-tvplus-linear-85d7d49859-sb69g.jpeg"},{"s":1795851306,"e":1795854408,"t":"Andromeda","st":"Tempo fuori dalla mente","d":"L'Abisso ha ucciso l'amico di Beka e l'equipaggio deve capire perché.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670668423_13_20260304T004228285Z_63_imageprocessorclient-tvplus-linear-85d7d49859-jzjjm.jpeg"},{"s":1795854408,"e":1795857510,"t":"Andromeda","st":"L'intervallo dissonante (Parte 1)","d":"Andromeda salva una nave di ritorno dai colloqui di pace con Magog.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670679354_2_20260304T004227812Z_141_imageprocessorclient-tvplus-linear-85d7d49859-2fhcp.jpeg"},{"s":1795857510,"e":1795860612,"t":"Andromeda","st":"L'intervallo dissonante (Parte 2)","d":"L'attacco di Magog ha conseguenze terribili. L'Andromeda viene distrutta e sembra che Trance e Dylan siano gli unici superstiti. Dylan fugge nella rotta dei secoli.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670674386_71_20260304T004230318Z_79_imageprocessorclient-tvplus-linear-85d7d49859-2blcr.jpeg"},{"s":1795860612,"e":1795863844,"t":"Andromeda","st":"Il peso (Parte 1)","d":"Dylan finisce a Seefra, popolato da persone superstiziose prive di tecnologia.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670669328_68_20260304T004230192Z_87_imageprocessorclient-tvplus-linear-85d7d49859-ggck2.jpeg"},{"s":1795863844,"e":1795867076,"t":"Andromeda","st":"Il peso (Parte 2)","d":"Beka viene scaricata su Seefra dopo che l'Andromeda è stata rubata. Dylan deve dimostrare che la nave gli appartiene.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670669988_50_20260304T004229633Z_44_imageprocessorclient-tvplus-linear-85d7d49859-b9h9w.jpeg"},{"s":1795867076,"e":1795870308,"t":"Andromeda","st":"Il feromone della paura","d":"Ancora su Seefra, Dylan ritrova Harper, che si è adattato alla vita lì.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670669344_21_20260304T004228487Z_51_imageprocessorclient-tvplus-linear-85d7d49859-fz6dc.jpeg"},{"s":1795870308,"e":1795873540,"t":"Andromeda","st":"La caduta dell'angelo","d":"Doyle è in realtà un androide costruito da Harper per contenere la programmazione di base di Rommie.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670675215_10_20260304T004228278Z_22_imageprocessorclient-tvplus-linear-85d7d49859-s72h4.jpeg","ep":"S07E02"}]