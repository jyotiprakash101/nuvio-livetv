[{"s":1795849737,"e":1795851687,"t":"Gli incubi della natura","st":"La giungla del Borneo","d":"Nella giungla del Borneo, Naomi si cala in un'enorme caverna, s'imbatte in un orso e ne sperimenta il morso.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_996459177_0_20250621T075546175Z_53_imageprocessorclient-tvplus-linear-5db7c6bc99-gkp68.jpeg"},{"s":1795851687,"e":1795853615,"t":"Gli incubi della natura","st":"New York","d":"Su un grattacielo, Naomi cerca uno sciame e scova un procione: i terrori urbani! E incontra un succhiasangue.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_996459177_0_20250621T075546175Z_53_imageprocessorclient-tvplus-linear-5db7c6bc99-gkp68.jpeg"},{"s":1795853615,"e":1795855547,"t":"Gli incubi della natura","st":"Pembrokeshire","d":"Naomi è sulla costa del Pembrokeshire per perlustrare grotte e baie in cerca del più grande carnivoro inglese.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_996459177_0_20250621T075546175Z_53_imageprocessorclient-tvplus-linear-5db7c6bc99-gkp68.jpeg"},{"s":1795855547,"e":1795857568,"t":"Le meraviglie degli animali#Parte 12","st":"Pinguini","d":"I pinguini hanno zampe tozze e ali rigide, ma sono proprio questi tratti ad aiutarli a sopravvivere.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_947590337_0_20250604T155636276Z_148_imageprocessorclient-tvplus-linear-6fb5b47f79-lcmj2.jpeg"},{"s":1795857568,"e":1795859561,"t":"Le meraviglie degli animali#Parte 12","st":"Orsi","d":"Gli orsi vivono praticamente in qualsiasi habitat, dalle giungle tropicali all'Oceano Artico.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_947590337_0_20250604T155636276Z_148_imageprocessorclient-tvplus-linear-6fb5b47f79-lcmj2.jpeg"},{"s":1795859561,"e":1795861568,"t":"Le meraviglie degli animali#Parte 12","st":"Grandi felini","d":"Perché i grandi felini sono cacciatori così abili?","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_947590337_0_20250604T155636276Z_148_imageprocessorclient-tvplus-linear-6fb5b47f79-lcmj2.jpeg"},{"s":1795861568,"e":1795863579,"t":"Le meraviglie degli animali#Parte 12","st":"Formiche","d":"I metodi ingegnosi con cui le formiche hanno colonizzato la Terra.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_947590337_0_20250604T155636276Z_148_imageprocessorclient-tvplus-linear-6fb5b47f79-lcmj2.jpeg"},{"s":1795863579,"e":1795865595,"t":"Le meraviglie degli animali#Parte 12","st":"Volpi","d":"Perché il numero di volpi è in aumento e la loro estensione geografica si sta espandendo?","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_947590337_0_20250604T155636276Z_148_imageprocessorclient-tvplus-linear-6fb5b47f79-lcmj2.jpeg"},{"s":1795865595,"e":1795867595,"t":"Le meraviglie degli animali#Parte 12","st":"Elefanti","d":"Perché i peli sulla pelle degli elefanti li aiutano a mantenersi freschi?","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_947590337_0_20250604T155636276Z_148_imageprocessorclient-tvplus-linear-6fb5b47f79-lcmj2.jpeg"},{"s":1795867595,"e":1795871193,"t":"Il falco superveloce Il mondo della natura","st":"L'ultimo dei macachi","d":"Il documentarista Colin Stafford-Johnson ritrova un branco di cinopitechi.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_947597857_0_20250604T155636275Z_79_imageprocessorclient-tvplus-linear-6fb5b47f79-lcmj2.jpeg"},{"s":1795871193,"e":1795874590,"t":"Il falco superveloce Il mondo della natura","st":"Sri Lanka: isola degli elefanti","d":"Lo Sri Lanka è terra di elefanti speciali. Il cameraman Martyn Colbeck svelerà il loro mondo.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc