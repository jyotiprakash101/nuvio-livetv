[{"s":1795282800,"e":1795288200,"t":"자랑할 개 있습니다 1회","d":"국내 최초! 최강 스타들의 댕댕이 자랑 대결!중식 대가 이연복, 워터밤 여신 권은비, 트롯 프린스 김용빈, 4차원 배우 예지원, 청소광 브라이언이 한자리에 모였다!댕댕이 앞에선 품위는 잠시 반납!쉴 새 없는 내 새꾸 자랑에 개인기 진검승부, 급기야 스타들끼리 댕싸움(?) 발발?!어디서도 못 볼 스타들과 댕댕이의 깜찍한 케미와 가슴 뭉클한 사연까지!재미와 감동이 가득 담긴, 세상 특별한 내 새꾸 자랑 쇼가 시작됩니다♥","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_3750514043_0_20261111T154505224Z_1_imageprocessorclient-tvplus-linear-6b56cc9f55-wlc7k.jpeg"},{"s":1795288200,"e":1795290000,"t":"식객 허영만의 백반기행 특별판","d":"식객 허영만의 백반기행 특별판","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_1949548916_0_20250918T175835156Z_34_imageprocessorclient-tvplus-linear-d7c8c765b-xzq4r.jpeg"},{"s":1795290000,"e":1795291200,"t":"TV CHOSUN 재난특집","d":"TV CHOSUN 재난특집","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_1949548916_0_20250918T175835156Z_34_imageprocessorclient-tvplus-linear-d7c8c765b-xzq4r.jpeg"},{"s":1795291200,"e":1795294800,"t":"질병의 법칙 128회","d":"모발 건강 회복을 위한 방법이 공개된다.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_3788861848_0_20261119T133431969Z_1_imageprocessorclient-tvplus-linear-6b56cc9f55-xp664.jpeg"},{"s":1795294800,"e":1795298400,"t":"메디컬 스토리 주어진 시간 32회","d":"평생의 숙제라 불리는 다이어트!날씨가 추워지면서 활동량은 줄고, 체중 관리의 어려움은 커지고 있다.특히 나이가 들수록 운동과 식단 관리에도 좀처럼 빠지지 않는 살!게다가 무작정 식사량을 줄이는 다이어트는 근육까지 잃을 수 있어,체지방은 줄이고 근육은 지키는 건강한 다이어트 방법이 필요하다! 그 방법을 찾기 위해 주목해야 할 것이 있다. 바로 우리 몸속 '장내 환경'이다.장내 환경이 체지방과 대사 건강은 물론 근육 건강에도 영향을 미칠 수 있다는사실이 알려지면서 체중 관리의 열쇠로 주목받고 있다.도대체 장내 환경은 다이어트에 어떤 영향을 미치는 걸까?체지방은 줄이고 근육은 지키는 건강한 체중 관리의 비결!그동안 몰랐던 장내 환경의 비밀을 공개한다.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_3760288831_0_20261113T152749580Z_1_imageprocessorclient-tvplus-linear-6b56cc9f55-tqrh6.jpeg"},{"s":1795298400,"e":1795300200,"t":"건강한 아침 해뜰날 81회","d":"면역력 채우는 건강법이 공개된다.","i":"https://tvpnlogopus.samsungcloud.t