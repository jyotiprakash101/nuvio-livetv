[{"s":1795848907,"e":1795850345,"t":"베베핀","st":"생일 축하송","d":"베베핀에게 들키기 않고 깜짝 생일 파티를 준비할 수 있을까요?와! 기다리고 기다리던 베베핀의 생일이에요! 베베핀 몰래 멋진 생일 파티를 준비하려는 가족들!\r사랑하는 베베핀, 생일 축하합니다!","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_3689558384_0_20261030T011144635Z_87_imageprocessorclient-tvplus-linear-6b56cc9f55-xp664.jpeg"},{"s":1795850345,"e":1795851391,"t":"베베핀","st":"쿵쾅쾅 다섯 마리 원숭이 (영어)","d":"다섯 꼬마 원숭이 쿵쾅쾅! 신나게 뛰다가 머리를 쿵! 베베핀 보라 브로디가 원숭이 인형을 들고 쿵쿵 뛰어놀고 있어요. 여보세요 선생님! 큰일 났어요! 안돼 안돼! 원숭이 인형이 다치지 않게 조심해야지!","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_2865778790_0_20260502T012443175Z_67_imageprocessorclient-tvplus-linear-796646965d-md84g.jpeg"},{"s":1795851391,"e":1795852665,"t":"베베핀","st":"누가 더 빠를까? (영어)","d":"영어로 한 번, 한글로 한 번! 베베핀과 즐거운 노래를 통해 영어와 친해져요!\r매일 한 뼘씩 자라는 베베핀 가족의 성장일기를 즐거운 노래로 만나보세요. 베베핀과 함께 즐겁게 춤추고 노래하면서 놀이도, 생활습관도, 숫자도, 영어도 자연스럽게 배워봐요!","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_2906383870_0_20260511T094201432Z_127_imageprocessorclient-tvplus-linear-796646965d-n2g86.png"},{"s":1795852665,"e":1795853901,"t":"베베핀","st":"과 영어 흘려듣기 Ep5","d":"재밌는 동요를 따라 부르며 쉽게 영어 공부해요베베핀과 한글로 한 번, 영어로 한 번!","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_3425378914_1_20260904T004134704Z_124_imageprocessorclient-tvplus-linear-6b56cc9f55-zzrrj.jpeg"},{"s":1795853901,"e":1795855142,"t":"베베핀","st":"즐거운 정원 가꾸기","d":"텃밭에 채소를 심어봐요! 흙에 구멍을 내고 씨앗을 심어요. 채소가 잘 자라기 위해 물과 햇빛도 충분히 줘야 해요. 내가 직접 키우는 채소! 얼마나 예쁘게 자라날까요?","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_2823994777_25_20260422T060029787Z_23_imageprocessorclient-tvplus-linear-796646965d-2k68x.jpeg"},{"s":1795855142,"e":1795856381,"t":"베베핀","st":"사이좋게 차례차례","d":"미끄럼틀도 그네도 모두 차례차례! 차례차례 노는 것이 훨씬 더 재밌어요. 베베핀 가족들처럼 순서를 지키면서 즐겁게 놀아 볼까요?","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_U