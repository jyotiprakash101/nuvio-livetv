[{"s":1795844105,"e":1795847432,"t":"Star Trek: The Next Generation","st":"The Neutral Zone","d":"Under en rejse på vej til et møde med de fjendtlige romulanere finder besætningen et skib med tre nedfrosne amerikanere fra det 20. århundrede.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E26"},{"s":1795847432,"e":1795850755,"t":"Star Trek: The Next Generation","st":"The Child","d":"Mens besætningen gør klar til at transportere en dødelig virus til et laboratorium, annoncerer rådgiver Troi, at hun er gravid.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E01"},{"s":1795850755,"e":1795854085,"t":"Star Trek: The Next Generation","st":"Where Silence Has Lease","d":"Besætningen tages som gidsler i et mystisk tomrum af et væsen, der vil observere alle de måder, mennesker kan dø på.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E02"},{"s":1795854085,"e":1795857407,"t":"Star Trek: The Next Generation","st":"Elementary, Dear Data","d":"Data påtager sig rollen som Sherlock Holmes på holodækket for at opklare et mysterium, der truer dr. Pulaskis liv.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E03"},{"s":1795857407,"e":1795860732,"t":"Star Trek: The Next Generation","st":"The Outrageous Okona","d":"Mens Enterprises besætning er vært for en frafalden og vittig kaptajn, kæmper Data med at få en humoristisk sans.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E04"},{"s":1795860732,"e":1795864050,"t":"Star Trek: The Next Generation","st":"Loud As A Whisper","d":"En krigsramt planets fremtid afhænger af en døv mægler, som mister evnen til at kommunikere.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E05"},{"s":1795864050,"e":1795867360,"t":"Star Trek: The Next Generation","st":"Unnatural Selection","d":"Besætningen kæmper med en mystisk sygdom, som fremskynder ældningsprocessen og dræber mennesker af alderdom på få dage.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E07"},{"s":1795867360,"e":1795870682,"t":"Star Trek: The Next Generation","st":"A Matter Of Honor","d":"Rikers loyalitet bliver sat på prøve, da han sendes ud til et klingonsk fartøj, som planlægger at angribe Enterprise.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E08"},{"s":1795870682,"e":1795874010,"t":"Star Trek: The Next Generation","st":"The Measure Of A Man","d":"Da Data nægter at blive skilt ad i forskningsøjemed, bliver Picard sat til at forsvare hans rettigheder i en retssal.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E09"},{"s":1795874010,"e":1795877333,"t":"Star Trek: The Next Generation","st":"The Dauphin","d":"Wesley finder kærligheden hos den smukke unge regent af Daled Four, hvis hemmelige kræfter kan ødelægge Enterprise og dets besætning.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E10"},{"s":1795877333,"e":1795880657,"t":"Star Trek: The Next Generation","st":"Contagion","d":"Enterprises computersystem bliver invaderet af en mystisk virus, som programmerer skibet til at selvdestruere.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E11"},{"s":1795880657,"e":1795883979,"t":"Star Trek: The Next Generation","st":"The Royale","d":"Landgangspatruljen finder et stykke metal fra De Forenede Staters luftvåben og bliver fanget i \"Hotel Royale\", en roman, der er vækket til live.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E12"},{"s":1795883979,"e":1795887300,"t":"Star Trek: The Next Generation","st":"Time Squared","d":"U.S.S. Enterprise finder en rumfærge fra Føderationen med en kopi af kaptajn Picard fra seks timer ude i fremtiden.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E13"},{"s":1795887300,"e":1795890622,"t":"Star Trek: The Next Generation","st":"The Icarus Factor","d":"Rikers far dukker op aftenen før, han skal ud at være kaptajn på et nyt stjerneskib.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E14"},{"s":1795890622,"e":1795893942,"t":"Star Trek: The Next Generation","st":"Pen Pals","d":"Data prøver at redde en lille pige på en dødsdømt planet.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E15"},{"s":1795893942,"e":1795897268,"t":"Star Trek: The Next Generation","st":"Samaritan Snare","d":"Mens Picard kæmper for sit liv på operationsbordet, bliver Geordi taget som gidsel af rumvæsener.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E17"},{"s":1795897268,"e":1795900590,"t":"Star Trek: The Next Generation","st":"Up The Long Ladder","d":"En redningsmission af en forsvunden Jord-koloni fører til opdagelsen af en civilisation, der består af kloner.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E18"},{"s":1795900590,"e":1795903909,"t":"Star Trek: The Next Generation","st":"Manhunt","d":"Trois mor besøger Enterprise i en søgen efter den perfekte mage og sætter jagten ind på kaptajn Picard.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E19"}]