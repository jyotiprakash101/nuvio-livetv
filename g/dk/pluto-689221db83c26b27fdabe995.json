[{"s":1795278032,"e":1795284332,"t":"Star Trek: Voyager: Den mørke grænse","st":"Den mørke grænse","d":"Under en mission mod Borg lokkes Seven of Nine tilbage til Kollektivet. Da Seven trues med assimilation ind i Kollektivet, starter Janeway en mission for at redde hende","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c53e73a0a1001453effc/tile_1790722446315.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E15"},{"s":1795284332,"e":1795287692,"t":"Star Trek: Voyager: The Disease","st":"The Disease","d":"Kim puts his future with Voyager at risk when he chooses love over duty.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c53e73a0a1001453effc/tile_1790722446315.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E16"},{"s":1795287692,"e":1795290932,"t":"Star Trek: Voyager: Fair Haven","st":"Fair Haven","d":"Janeway’s holographic love interest becomes more than just a way to pass the time.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c53e73a0a1001453effc/tile_1790722446315.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S06E11"},{"s":1795290932,"e":1795294254,"t":"Star Trek: The Next Generation","st":"Elementary, Dear Data","d":"Data påtager sig rollen som Sherlock Holmes på holodækket for at opklare et mysterium, der truer dr. Pulaskis liv.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E03"},{"s":1795294254,"e":1795297582,"t":"Star Trek: The Next Generation","st":"The Measure Of A Man","d":"Da Data nægter at blive skilt ad i forskningsøjemed, bliver Picard sat til at forsvare hans rettigheder i en retssal.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E09"},{"s":1795297582,"e":1795300909,"t":"Star Trek: The Next Generation","st":"The Offspring","d":"Data bliver far, da han skaber en ny androide ved at kopiere sin egen neuralprogrammering.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E16"},{"s":1795300909,"e":1795304232,"t":"Star Trek: The Next Generation","st":"Suddenly Human","d":"Picard risikerer en krig, da han nægter at levere en menneskedreng til den rumvæsenfar, der opfostrede og måske misbrugte ham.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E04"},{"s":1795304232,"e":1795307558,"t":"Star Trek: The Next Generation","st":"Data's Day","d":"En vens kommende bryllup gør Data forvirret omkring nuancerne i menneskelige følelser.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E11"},{"s":1795307558,"e":1795310882,"t":"Star Trek: The Next Generation","st":"Fistful Of Datas, A","d":"En fantasi på holodækket går skævt og sender Worf og hans søn til det vilde vesten og en skurk, der ligner Data på en prik.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S06E08"},{"s":1795310882,"e":1795314176,"t":"Star Trek: The Next Generation","st":"Birthright Part I","d":"Worf og Data begiver sig ud på en rejse for at finde deres fædre.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S06E16"},{"s":1795314176,"e":1795317471,"t":"Star Trek: The Next Generation","st":"Birthright Part II","d":"Worf holdes fanget i et samfund, hvor klingoner og romulanere lever sammen, og han sætter livet på spil for at vise de unge klingoner deres herkomst og inspirere dem til at genvinde æren.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S06E17"},{"s":1795317471,"e":1795320766,"t":"Star Trek: The Next Generation","st":"Descent Part I","d":"Da borgerne vender tilbage for at gå i krig mod Føderationen, har de opnået individualitet, og de frister Data, da de hjælper ham med hans første følelse.","c":["Science fiction","Series","Action"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S06E26"},{"s":1795320766,"e":1795324064,"t":"Star Trek: The Next Generation","st":"Descent Part II","d":"Picard, Troi og Geordi holdes fanget af Data, som har forladt Enterprise og sluttet sig til sin onde bror, Lore, for at lede borgerne.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S07E01"},{"s":1795324064,"e":1795327360,"t":"Star Trek: The Next Generation","st":"Phantasms","d":"Datas første mareridt bliver virkelighed for resten af besætningen.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S07E06"},{"s":1795327360,"e":1795330684,"t":"Star Trek: The Next Generation","st":"Encounter At Farpoint - Part 1","d":"Enterprises besætning stilles for retten af et mystisk væsen ved navn \"Q\" for hele menneskehedens forbrydelser.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E01"},{"s":1795330684,"e":1795334015,"t":"Star Trek: The Next Generation","st":"Encounter At Farpoint - Part 2","d":"Enterprises besætning stilles for retten af et mystisk væsen ved navn \"Q\" for hele menneskehedens forbrydelser.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E02"},{"s":1795334015,"e":1795337339,"t":"Star Trek: The Next Generation","st":"Conspiracy","d":"Kaptajn Picard og kommandør Riker rejser til Jorden for at efterforske en sammensværgelse blandt Overkommandoens højeste officerer.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E25"},{"s":1795337339,"e":1795340660,"t":"Star Trek: The Next Generation","st":"Q-Who?","d":"Besætningen sendes til en fjern galakse af den ondskabsfulde Q, som sætter dem op imod en race af halvt menneske, halvt maskine, som kalder sig borgerne.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E16"},{"s":1795340660,"e":1795343986,"t":"Star Trek: The Next Generation","st":"Samaritan Snare","d":"Mens Picard kæmper for sit liv på operationsbordet, bliver Geordi taget som gidsel af rumvæsener.","c":["Science fiction","Series"],"i":"https://images.pluto.tv/series/6a9011bd763ed26aa4fb10fb/tile_1787826621650.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E17"}]