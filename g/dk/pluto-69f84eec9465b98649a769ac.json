[{"s":1795281601,"e":1795284885,"t":"Amalies Verden","st":"Afsnit 5","d":"Amalie bliver tilbudt at lave sin helt egen blog, hvor hun skal skrive om sit liv, og alle de spændende ting hun oplever.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E05"},{"s":1795284885,"e":1795288037,"t":"Amalies Verden","st":"Afsnit 6","d":"I Amalies Verden er øjeblikket kommet, hvor mor Lottes store drøm bliver til virkelighed. Hun skal for første gang se portrættet af hende og Amalie i rokokokjoler, og synet af maleriet får Lottes tårer til at trille af begejstring.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E06"},{"s":1795288037,"e":1795291142,"t":"Amalies Verden","st":"Afsnit 7","d":"Amalie er frontfigur for onkel Sebastians pokerportal, og han har derfor spurgt, om hun vil hjælpe med at arrangere en stor pokerturnering.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E07"},{"s":1795291142,"e":1795294430,"t":"Amalies Verden","st":"Afsnit 8","d":"For Amalie åbner der sig en verden af nye muligheder, da hun får rollen i en \"dummie\" til DR sammen med andre kendte skuespillere.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E08"},{"s":1795294430,"e":1795297578,"t":"Amalies Verden","st":"Afsnit 9","d":"Amalie og Peter skal ud på en skole og holde foredrag for eleverne om, hvordan det er at være kendt.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=7