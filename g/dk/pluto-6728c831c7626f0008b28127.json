[{"s":1795844367,"e":1795847302,"t":"Jersey Shore Family Vacation","st":"Jersey Shore Family Vacation-genforening, første del","d":"Bofællerne samles for at fejre 15 års kaos og ikoniske øjeblikke. Fra spøgelsesjagt på Cape May til Nicoles oprindelsesrejse. Første del bringer jer overraskelser, yndlingsminder og det store spørgsmål: Bliver Sammi og Ronnie forsonet?","c":["Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E17"},{"s":1795847302,"e":1795850391,"t":"Jersey Shore Family Vacation","st":"Jersey Shore Family Vacation-genforening, anden del","d":"Bofællerne taler videre om sol og skumle og chokerende øjeblikke. De taler om Jamaicas dramatik og sjove øjeblikke. Er Angelina og Lauren stadig uvenner? Plus yndlingsøjeblikke, uventede gæster og latter, mens de genoplever deres 15 år på stranden.","c":["Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E18"},{"s":1795850391,"e":1795853453,"t":"Jersey Shore Family Vacation","st":"Se, hvem der fylder 40","d":"Surprise! Jenni fylder 40. Suprise! Angelina har chokerende nyt, og Surprise, Sammi er...","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E19"},{"s":1795853453,"e":1795856424,"t":"Jersey Shore Family Vacation","st":"Jersey Shore Family Vacation #820","d":"De medvirkende i Jersey Shore svor på, at de altid ville holde ferie sammen. Nu fem år, fem børn, tre ægteskaber og hvem ved, hvor mange GTL-omgange senere er slænget sammen igen og på ferie i det lækre hus i Miami Beach.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E20"},{"s":1795856424,"e":1795859341,"t":"Jersey Shore Family Vacation","st":"Jersey Shore Family Vacation #821","d":"Bofællerne tager til Boston og invaderer ikoniske Fenway Park og besøger en bar.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E21"},{"s":1795859341,"e":1795862338,"t":"Jersey Shore Family Vacation","st":"Borgmesteren af Kyllingekøbing","d":"I Boston tager bofællerne til kyllingefrittens fødested og stemningen bliver ophidset mellem Deena og Vinny.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E22"},{"s":1795862338,"e":1795865428,"t":"Jersey Shore Family Vacation","st":"Tilbage til skolen","d":"Guidoerne er tilbage i skolen med en dygtig professor.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E23"},{"s":1795865428,"e":1795868545,"t":"Jersey Shore Family Vacation","st":"Kødboller mod Boston","d":"Da Boston-turen ender, ryger kødbollerne til tælling. Og Mike har et godt tilbud.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E24"},{"s":1795868545,"e":1795871660,"t":"Jersey Shore Family Vacation","st":"Jamptons","d":"Mike er ikke hovedperson mere, og Angelina betror sig til bofællerne.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E25"},{"s":1795871660,"e":1795874779,"t":"Jersey Shore Family Vacation","st":"Dobbeltbooket","d":"Jamptons-turen er i fuld gang, og Mike søger et ja fra Sammi. Angelina vil starte på en frisk.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E26"},{"s":1795874779,"e":1795877774,"t":"Jersey Shore Family Vacation","st":"BDS Eventmager","d":"Der afholdes fest i Jamptons-huset. Mike går endnu mere over gevind til Sammis kønsafsløringsfest.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E27"},{"s":1795877774,"e":1795880746,"t":"Jersey Shore Family Vacation","st":"Det er en dreng!","d":"Det er en vild sommer i Jersey: Angelina puster nyt liv i et gammelt forhold, og efter alle afsløringerne og babyshowerne får Sammi endelig lov til at møde sin lille dreng.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E28"},{"s":1795880746,"e":1795883741,"t":"Jersey Shore Family Vacation","st":"Bleer og beskeder","d":"Sammi starter livet som nybagt mor. Ronnie skjuler noget stort. Mike inspirerer videre.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E29"},{"s":1795883741,"e":1795886856,"t":"Jersey Shore Family Vacation","st":"Padelslaget","d":"Mike mægler mellem Angelina og 2.0, og Deena velgørenhedsevent gør alle utrygge.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E30"},{"s":1795886856,"e":1795889974,"t":"Jersey Shore Family Vacation","st":"Ikke under konstruktion mere","d":"Mike bruger Times Square til sit comeback og Angelina og Vinny går endnu en omgang.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E31"},{"s":1795889974,"e":1795893081,"t":"Jersey Shore Family Vacation","st":"Situation & Ronnie","d":"Ronnie og Mike gør Vegas til en ren bromance. Skabe ryddes, og køer indblandes.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E32"},{"s":1795893081,"e":1795896194,"t":"Jersey Shore Family Vacation","st":"Friske starter","d":"Pigerne overøser Sammi med kærlighed. Nikke er ærlig om fremtiden, og Vinny driller familien kærligt.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E33"},{"s":1795896194,"e":1795899307,"t":"Jersey Shore Family Vacation","st":"Stilheden før roasten","d":"Nedtællingen til Jersey Shore-roasten begynder.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E34"},{"s":1795899307,"e":1795902418,"t":"Jersey Shore Family Vacation","st":"Jersey Shore-roasten","d":"Får Mike revanche? Overlever venskaberne vitserne?","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E35"},{"s":1795902418,"e":1795905530,"t":"Jersey Shore Family Vacation","st":"40, For evigt og Farvel","d":"En uforglemmelig og følelsesladet Jersey Shore Vacation-finale.","c":["Human Interest","Series","Reality"],"i":"https://images.pluto.tv/series/62062d3433b8100013b8a76a/tile_1765870854413.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S08E36"}]