cloud.tv/platform/image/contents/vc/00/LINEAR/ES_USQO570425A_1940668412_1_20260617T201839300Z_1_imageprocessorclient-tvplus-linear-66fc4d58c8-6w69q.jpeg"},{"s":1795302362,"e":1795303845,"t":"Plato principal en Maine","d":"Los moteros están en Maine, donde el marisco es un modo de vida.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/ES_USQO570425A_1940668412_1_20260617T201839300Z_1_imageprocessorclient-tvplus-linear-66fc4d58c8-6w69q.jpeg"},{"s":1795303845,"e":1795305660,"t":"Episodio 1","d":"Rick cocina paella y un picante curry de pescado tailandés.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/ES_USQO570425A_1940666826_3_20260617T201834084Z_34_imageprocessorclient-tvplus-linear-66fc4d58c8-nbtjg.jpeg"},{"s":1795305660,"e":1795307458,"t":"Episodio 2","d":"El chef prepara más delicias del mar inspiradas en sus viajes.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/ES_USQO570425A_1940666826_3_20260617T201834084Z_34_imageprocessorclient-tvplus-linear-66fc4d58c8-nbtjg.jpeg"}]