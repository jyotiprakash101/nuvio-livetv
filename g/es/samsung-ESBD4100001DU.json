[{"s":1795846584,"e":1795851112,"t":"Descendientes del sol Ep.10","d":"Una enfermedad se propaga y los recursos escasean. Sijin recibe órdenes que limitan sus acciones.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/ES_USQT620324A_2101178897_2_20260813T084318446Z_22_imageprocessorclient-tvplus-linear-648598f6b5-x588x.jpeg"},{"s":1795851112,"e":1795855667,"t":"Descendientes del sol Ep.11","d":"Myungju enferma gravemente y el tratamiento se retrasa. Moyeon toma decisiones arriesgadas para salvarla.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/ES_USQT620324A_2101077608_0_20260813T084322423Z_90_imageprocessorclient-tvplus-linear-648598f6b5-7mbhf.jpeg"},{"s":1795855667,"e":1795860160,"t":"Descendientes del sol Ep.12","d":"Sijin se infiltra solo en territorio enemigo. Un encuentro inesperado cambia el rumbo de todo.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/ES_USQT620324A_2101159289_3_20260813T084315763Z_22_imageprocessorclient-tvplus-linear-648598f6b5-lvf64.jpeg"},{"s":1795860160,"e":1795864678,"t":"Descendientes del sol Ep.13","d":"Moyeon regresa a Corea y toma una decisión radical. Sijin recibe nuevas órdenes lejos de su base.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/ES_USQT620324A_2101077606_1_20260813T084323479Z_26_imageprocessorclient-tvplus-linear-648598f6b5-fnlxm.jpeg"},{"s":1795864678,"e":1795869122,"t":"Descendientes del sol Ep.14","d":"Moyeon intenta salvar a Sijin mientras su vida pende de un hilo. Otros también enfrentan decisiones extremas.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/ES_USQT620324A_2101098320_1_20260813T084318459Z_94_imageprocessorclient-tvplus-linear-648598f6b5-fnlxm.jpeg"},{"s":1795869122,"e":1795873685,"t":"Descendientes del sol Ep.15","d":"Las relaciones se tensan y una misión peligrosa separa nuevamente a Sijin y Moyeon.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/ES_USQT620324A_2101077607_3_20260813T084315763Z_101_imageprocessorclient-tvplus-linear-648598f6b5-lvf64.jpeg"}]