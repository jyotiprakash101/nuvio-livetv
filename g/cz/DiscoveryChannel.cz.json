[{"s":1795201200,"e":1795204800,"t":"Lidé z aljašských lesů","st":"Surviving the Lower 48","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f0abe862dc64444136076e7cee2c481a.jpg","ep":"S5 E6"},{"s":1795204800,"e":1795206600,"t":"Virální zločiny","st":"Bold Moves","d":"Ozbrojený lupič zaútočí na mladou ženu, ale ta se mu odvážně postaví a útočníka odrazí. Jízda na motorce se promění v násilný incident na silnici.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/3/394e424a1039bb35cb8b09616f408797.jpg","ep":"S1 E4"},{"s":1795206600,"e":1795208400,"t":"Virální zločiny","st":"Přichycen při činu","d":"Podivný muž se pokusí násilím jedné ženě unést děti, ale mladý zápasník vše zachrání. A také se za bílého dne odehraje jedna děsivá loupež.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/3/394e424a1039bb35cb8b09616f408797.jpg","ep":"S1 E7"},{"s":1795208400,"e":1795212000,"t":"Ze zákulisí kasina ve Vegas","st":"Sex, Lies & Surveillance Tape","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/8/8719245762faf9311815bfce1f8b40e3.jpg","ep":"S1 E3"},{"s":1795212000,"e":1795215600,"t":"Hraniční kontrola: Itálie","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad/600/8/86819fb243204926ebf2dec1c77ff063.jpg","ep":"S1 E8"},{"s":1795215600,"e":1795219200,"t":"Hraniční kontrola: Itálie","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad/600/8/86819fb243204926ebf2dec1c77ff063.jpg","ep":"S1 E9"},{"s":1795219200,"e":1795222800,"t":"Rození obchodníci vyrážejí do světa II: Česko","st":"Czechia: Skoda 110r","d":"Mike a Elvis se snaží proměnit vzácnou Škodu 110R pro potřeby rallye, ale brzy zjistí, že půjde o větší a dražší zakázku, než si mysleli.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/a/a717a905a7186665058eff42cfde3dc2.jpg","ep":"S2 E7"},{"s":1795222800,"e":1795226400,"t":"Rození obchodníci vyrážejí do světa II: Itálie","st":"Italy: Fiat Barchetta","d":"Mike a Elvis jedou do Turína zachránit zchátralý Fiat Barchetta. Bohužel se ukáže, že náhradní díly je téměř nemožné sehnat.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/a/a717a905a7186665058eff42cfde3dc2.jpg","ep":"S2 E8"},{"s":1795226400,"e":1795230000,"t":"Rození obchodníci vyrážejí do světa II: Malta","st":"Malta: Ford Cortina MK2","d":"Mike, který už 20 let toužil koupit Ford Cortina, konečně najde na Maltě Mk2 bez koroze. Zbytek auta je však v žalostném stavu.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/a/a717a905a7186665058eff42cfde3dc2.jpg","ep":"S2 E9"},{"s":1795230000,"e":1795233600,"t":"Rození obchodníci vyrážejí do světa II: Skotsko","st":"Scotland: Hillman Imp","d":"Mike a Elvis mají omezený rozpočet na opravu Hillman Impa. Mají co dělat, protože novinář už si chce zkontrolovat hotové auto.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/a/a717a905a7186665058eff42cfde3dc2.jpg","ep":"S2 E10"},{"s":1795233600,"e":1795237200,"t":"Lovci odpadu: Restaurátoři","st":"Fat Les","d":"Rebecca Pritchardová svěří své vzácné dědictví, sošku cherubína důvěrně známou jako Tlustý Les, sochaři Nicku Elphickovi, který musí sošce vrátit její původní vzhled.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/2/2997d6568782cf1b06bef3d4448af3d1.jpg","ep":"S6 E13"},{"s":1795237200,"e":1795239000,"t":"Jak se to dělá","st":"Upright Pianos, Flags, Wet/Dry Vacuums, Medieval Axes","d":"Podíváme se, jak se vyrábí další předměty každodenní potřeby. Tentokrát to budou pianina a vlajky.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4eaac3db053c6306a0438a351827cabd.jpg","ep":"S24 E3"},{"s":1795239000,"e":1795240800,"t":"Jak se to dělá","st":"Oil Lamps, Chocolate Mints, Underfloor Heating, Pillows","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4eaac3db053c6306a0438a351827cabd.jpg","ep":"S24 E2"},{"s":1795240800,"e":1795242600,"t":"Jak se to dělá","st":"Upright Pianos, Flags, Wet/Dry Vacuums, Medieval Axes","d":"Podíváme se, jak se vyrábí další předměty každodenní potřeby. Tentokrát to budou pianina a vlajky.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4eaac3db053c6306a0438a351827cabd.jpg","ep":"S24 E3"},{"s":1795242600,"e":1795244400,"t":"Jak se to dělá","st":"Automatic Sliding Doors, Gin, Firearms Restoration","d":"Podíváme se, jak se vyrábí další předměty každodenní potřeby. Tentokrát to budou pianina a vlajky.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4eaac3db053c6306a0438a351827cabd.jpg","ep":"S24 E5"},{"s":1795244400,"e":1795248000,"t":"Neobyčejná auta","st":"Beau a Bandita","d":"Tým si vezme inspiraci z minulosti, aby sestavil super moderní náklaďák. Inovativní sestava kombinuje velké množství koňských sil, novou technologii a součásti ze staré školy.","c":["Dokument","Komedie"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/7/79fd19ab0075275bc1339b27bf65b1f6.jpg","ep":"S1 E6"},{"s":1795248000,"e":1795251600,"t":"TransAm","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/b/b53293a1ce2f6834b24d666769260218.jpg","ep":"S1 E2"},{"s":1795251600,"e":1795255200,"t":"TransAm","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/b/b53293a1ce2f6834b24d666769260218.jpg","ep":"S1 E3"},{"s":1795255200,"e":1795258800,"t":"Americký chopper: Senior versus Junior","d":"Mikey řídí charitativní sbírku pro March of Dimes, OCC staví stroj šetrný k životnímu prostředí a PJD odhalí motorku pro March of Dimes. Senior se pokouší sblížit se svým synem.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/c5fc5e8e1872f36890ecaafbeae55f65.jpg","ep":"S8 E12"},{"s":1795258800,"e":1795262400,"t":"Americký chopper: Senior versus Junior","d":"Senior od Mikeyho dostal text a volá Juniorovi. PJD začíná stavět motorku pro Newmont Mining a OCC odhaluje motorku pro CIMA Green. Junior potom požádá Seniora o soukromou schůzku.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/c5fc5e8e1872f36890ecaafbeae55f65.jpg","ep":"S8 E13"},{"s":1795262400,"e":1795266000,"t":"Shortyho vysněný obchod","st":"Camaros, Impalas, Goodguys","d":"Shorty opravuje Camaro z roku 1969, Impalu z roku 1965, a přívěs ze 40. let.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/7/735578e3233e683edb3e87d9b3c8bb63.jpg","ep":"S2 E2"},{"s":1795266000,"e":1795269600,"t":"Shortyho vysněný obchod","st":"The Chupacabra Firebird","d":"Porkchop renovuje kabriolet Firebird z roku 1969 jakožto poctu Trans Am. Tým vůz vybaví novým spoilerem, zakázkovým interiérem a závodními pásy.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/7/735578e3233e683edb3e87d9b3c8bb63.jpg","ep":"S2 E1"},{"s":1795269600,"e":1795273200,"t":"V pěkné bryndě","st":"Epic Fail","d":"Jedná se o královnu her. Kamarádi vás unesou a vysadí vás uprostřed neznáma. Máte 100 hodin na to, abyste přežili. Podaří se vám to.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/d/d85a90696a3d0cdca669ef775a0546db.jpg","ep":"S2 E1"},{"s":1795273200,"e":1795276800,"t":"V pěkné bryndě","st":"African Ambush","d":"Odborníka na primitivní dovednosti Matta obelstí na nebezpečné africké savaně, kde zůstane sám a k pití má pouze krev. Jak se z této šlamastyky dostane.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/d/d85a90696a3d0cdca669ef775a0546db.jpg","ep":"S2 E2"},{"s":1795276800,"e":1795280400,"t":"Zlatá horečka: Ztracený důl Davea Turina","st":"Back on Gold","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd11602736fcaa92bd47af18e13a5078.jpg","ep":"S2 E5"},{"s":1795280400,"e":1795284000,"t":"Zlatá horečka: Ztracený důl Davea Turina","st":"Boundary Blowout","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd11602736fcaa92bd47af18e13a5078.jpg","ep":"S2 E6"},{"s":1795284000,"e":1795287600,"t":"Zlatá horečka: Ztracený důl Davea Turina","st":"Blue Room Bonanza","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd11602736fcaa92bd47af18e13a5078.jpg","ep":"S2 E7"},{"s":1795287600,"e":1795291200,"t":"Zlatá horečka: Ztracený důl Davea Turina","st":"All In","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd11602736fcaa92bd47af18e13a5078.jpg","ep":"S2 E8"},{"s":1795291200,"e":1795294800,"t":"Akta z expedic","st":"Kdo to udělal?","d":"Josh prověřuje tři záhady: smrt Meriwethera Lewise, leteckou havárii Daga Hammarskjölda a zmizení soudce Cratera.","c":["Dokument","Dobrodružný"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/e/ed4d88f651dc4c7cd32cfaccc4472c9f.jpg","ep":"S4 E8"},{"s":1795294800,"e":1795298400,"t":"Záhada ranče Blind Frog","st":"Detonation Threat","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/b/bfc3fefe55f8f8a0731465b27bc16a9b.jpg","ep":"S5 E5"},{"s":1795298400,"e":1795302000,"t":"Nazí a vystrašení","st":"Návnada na buvola","d":"V Jižní Africe se dva fanoušci pokoušejí zdolat 14denní výzvu uprostřed nebezpečného území buvolů kapských. Jejich schopnosti prověří silné deště a nestálé teploty.","c":["Dobrodružný","Horor"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/2/2a62f54b3cf3097889c463d16ea4dba9.jpg","ep":"S13 E6"},{"s":1795302000,"e":1795305600,"t":"Nazí a vystrašení","st":"Opuštěná vesnice","d":"Geolog a nomádka musejí přežít 21 dní v bažinách botswanské delty Okavango zamořených komáry. Čelí také nebezpečí ze strany sloních samců a hrochů.","c":["Dobrodružný","Horor"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/2/2a62f54b3cf3097889c463d16ea4dba9.jpg","ep":"S14 E11"},{"s":1795305600,"e":1795309200,"t":"Ostřílení řidiči kamionů","st":"Episode 1","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/1/15ba342e1c693c8d0f7c08441ca27eb6.jpg","ep":"S1 E1"},{"s":1795309200,"e":1795312800,"t":"Ostřílení řidiči kamionů","st":"Episode 3","c":["Dokument"],"i":"https: