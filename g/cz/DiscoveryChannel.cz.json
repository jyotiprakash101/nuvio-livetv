/~tri65dnigalerie/porad_booklet/600/0/08da0cb8a52f713c53ff34a1584aa12e.jpg","ep":"S11 E11"},{"s":1795424400,"e":1795428000,"t":"Lovci odpadu: Restaurátoři","st":"Episode #2.7","d":"Odborník na polituru Alex restauruje houpacího koně z 30. let. Sochař Nick zachrání kus z poloviny minulého století a čalouník Craig zkusí restaurovat klasické viktoriánské křeslo.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/2/2997d6568782cf1b06bef3d4448af3d1.jpg","ep":"S2 E7"},{"s":1795428000,"e":1795429800,"t":"Hledáme domek na pláži","st":"Florida Keys House Hunt","d":"Manželé ze Středozápadu se těší, že vymění chladné zimy v Minnesotě za nekonečnou letní zábavu na Florida Keys.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/e/e2d6a6e5083acba332042ba866089efe.jpg","ep":"S2 E11"},{"s":1795429800,"e":1795431600,"t":"Hledáme domek na pláži","st":"Destin, Florida House Hunt","d":"Floridský pár, který žije ve vnitrozemí, chce najít dům u pláže na pobřeží Destinu, kde by mohly vyrůstat jejich děti.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/e/e2d6a6e5083acba332042ba866089efe.jpg","ep":"S2 E12"},{"s":1795431600,"e":1795435200,"t":"Akvária na míru","st":"Akvárium pro švédský stůl","d":"Naše duo zhotoví obrovské akvárium jako bar pro majitele podniku Creek Casino. Je to jejich 10 000. akvárium a jedno z největších, které kdy postavili.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f3beeb3ae2e4fde5dd92cf3f3eb5db50.jpg","ep":"S7 E10"},{"s":1795435200,"e":1795438800,"t":"Akvária na míru","st":"Rozšíření podniku","d":"Naše duo má předělat celý vůz Toyota Highlander na akvárium a zároveň otevřít novou pobočku podniku ATM na jižní Floridě.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f3beeb3ae2e4fde5dd92cf3f3eb5db50.jpg","ep":"S7 E1"},{"s":1795438800,"e":1795442400,"t":"Záchrana statku","st":"Honey I Torched the Homestead","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f48d43061b656264bdb3308f4ab23a5c.jpg","ep":"S2 E4"},{"s":1795442400,"e":1795446000,"t":"Záchrana statku","st":"Grizzly Bait","d":"Rodiny, které žijí mimo civilizace, se musí rychle učit. V zoufalé snaze zachránit své usedlosti požádají odborníky na přežití, aby je připravili na ty nejhorší nástrahy přírody.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f48d43061b656264bdb3308f4ab23a5c.jpg","ep":"S2 E5"},{"s":1795446000,"e":1795449600,"t":"Naftové bratrstvo","st":"When Trucks Fly","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/6/6452fcc84d4646ebbf085365478d46f8.jpg","ep":"S2 E12"},{"s":1795449600,"e":1795453200,"t":"Rychle a hlasitě","st":"Cool Customline","c":["Dobrodružný","Komedie"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/2/22793a47100521dc5e34c0702de91294.jpg","ep":"S4 E3"},{"s":1795453200,"e":1795455000,"t":"Jak to dělají","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0d3fc664bfd2d1d8a5118e459b34e622.jpg","ep":"S11 E20"},{"s":1795455000,"e":1795456800,"t":"Jak se to dělá","st":"Laptops; Panettone; Saxophones","d":"Podrobně se zaměříme na další všední předměty a ukážeme si jedinečný způsob jejich výroby. Jak se například vyrábějí saxofony.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4eaac3db053c6306a0438a351827cabd.jpg","ep":"S31 E2"},{"s":1795456800,"e":1795460400,"t":"Lidé z aljašských lesů","st":"High Tide Housing","d":"Nečekaná návštěva starosty města Hoonah může navždy změnit tvář Browntownu.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f0abe862dc64444136076e7cee2c481a.jpg","ep":"S5 E7"},{"s":1795460400,"e":1795464000,"t":"Lidé z aljašských lesů","st":"Browntown or Bust","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f0abe862dc64444136076e7cee2c481a.jpg","ep":"S5 E1"},{"s":1795464000,"e":1795471200,"t":"Nazí a vystrašení","st":"Bro, Hold My Fear","d":"Čtyři muži, kteří neuspěli v předchozích výzvách, hledají možnost nápravy v Jižní Africe. Dokážou překonat své minulé neúspěchy a zvládnout 21 dní.","c":["Dobrodružný","Horor"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/2/2a62f54b3cf3097889c463d16ea4dba9.jpg","ep":"S15 E4"},{"s":1795471200,"e":1795474800,"t":"Hraniční kontrola: Itálie","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad/600/8/86819fb243204926ebf2dec1c77ff063.jpg","ep":"S1 E10"}]