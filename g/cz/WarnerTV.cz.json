/600/f/f86c631fac4c7faf0695a69f1524b5b3.jpg","ep":"S1 E3"},{"s":1795784400,"e":1795787700,"t":"Záchrana statku","d":"Pro rodiny, které se stěhují zcela mimo civilizační sítě, je důležité získání nových zkušeností a dovedností. Aby zachránili své usedlosti, osloví odborníky na přežití, aby je připravili na nejhorší.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f48d43061b656264bdb3308f4ab23a5c.jpg"},{"s":1795787700,"e":1795791600,"t":"Záchrana statku","st":"Za dveřmi je vlk","d":"Raneyovi pomáhají rodině Johnsonů, kteří nemají pitnou vodu ani potravu. Záhadní dravci usmrtili jejich psy a oni se bojí, že jsou na řadě.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f48d43061b656264bdb3308f4ab23a5c.jpg","ep":"S2 E1"},{"s":1795791600,"e":1795794900,"t":"Aljaška: Poslední hranice","st":"The Next Chapter","d":"Před odjezdem na vysokou školu prožije Etienne domácí obřad vstupu do dospělosti v divočině, a August konečně ví, co chce udělat se svou budoucností.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/d/d20bb9079a6a6460c6d3d5b05d582069.jpg","ep":"S11 E6"},{"s":1795794900,"e":1795798800,"t":"Zlatá horečka","c":["Dokument","Western"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/9/9e1a0daab5bc86553bbeb965f115be5f.jpg","ep":"S11 E18"},{"s":1795798800,"e":1795800300,"t":"Hraniční kontrola: Polsko","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd8e2cbcd5a0610257b6e4b55e66b19a.jpg","ep":"S4 E1"},{"s":1795800300,"e":1795802100,"t":"Hraniční kontrola: Polsko","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd8e2cbcd5a0610257b6e4b55e66b19a.jpg","ep":"S4 E2"},{"s":1795802100,"e":1795803900,"t":"Hraniční kontrola: Polsko","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd8e2cbcd5a0610257b6e4b55e66b19a.jpg","ep":"S4 E3"},{"s":1795803900,"e":1795806000,"t":"Hraniční kontrola: Polsko","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd8e2cbcd5a0610257b6e4b55e66b19a.jpg","ep":"S4 E4"},{"s":1795806000,"e":1795809300,"t":"Zlato z Beringova moře","st":"And No More Shall We Part","d":"Zeke, Emily and Steve mourn the death of a friend, as Shawn and Cody battle to patch a rapidly increasing hole in the hull of the 'Christine Rose'.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/ce543b43ad4796c077b96becb2f950c5.jpg","ep":"S2 E11"},{"s":1795809300,"e":1795812900,"t":"Zlato z Beringova moře","st":"The American Dream","d":"The dredgers break through Nome's frozen harbor for one last shot at gold. Scott Meisterheim's dredging season is headed for failure -- again, but the CHRISTINE ROSE scores big. Zeke blames himself for John Bunce's death.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/ce543b43ad4796c077b96becb2f950c5.jpg","ep":"S2 E12"},{"s":1795812900,"e":1795816500,"t":"Expedice X","st":"Into the Alien Ocean","d":"Mise Jess a Phila na ostrově Catalina se rozhoří podmořským nálezem.","c":["Mysteriozní"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0bdc96ac64b8652da7e9d8df5c291aef.jpg","ep":"S3 E7"},{"s":1795816500,"e":1795820100,"t":"Brány do pekla","st":"The Ohio State Reformatory","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/2/2534804cf17d1b14e623231015ef3cbf.jpg","ep":"S2 E8"},{"s":1795820100,"e":1795822800,"t":"Osobní kamery pro policii","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/a/a45712713979a7f6ac4a7bb1bdce929a.jpg"},{"s":1795822800,"e":1795825500,"t":"Spříznění duchové","st":"The Country Club Murders","d":"Amy, Adam a Chip vyšetřují venkovský klub v Západní Virginii, který je proslulý nevyřešenou dvojnásobnou vraždou.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0f2163586bf0dbf3c12a75732196d92c.jpg","ep":"S7 E10"},{"s":1795825500,"e":1795828200,"t":"Zapovězeno: Smrt z lásky","st":"Bound by Honor","c":["Drama"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/c0c258cb66a804653b5398de007f591b.jpg","ep":"S4 E10"},{"s":1795828200,"e":1795830900,"t":"Vybrala si mě vražda","st":"The Passenger","c":["Krimi"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f343c3a5b197e21fd1dfcfaa8e13c9a9.jpg","ep":"S3 E6"},{"s":1795830900,"e":1795833600,"t":"Vybrala si mě vražda","st":"Red Flags","c":["Krimi"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4efc78d305984b67ff34aff896f34056.jpg","ep":"S3 E7"},{"s":1795833600,"e":1795836300,"t":"Výprava do neznáma","st":"Chasing the Snake Kings","d":"Josh Gates se vrací do Guatemaly s potenciálním průlomem v pátrání po hrobce Hadího krále.","c":["Dobrodružný","Mysteriozní"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/1/1a4e674906d29b76627160a01804e045.jpg","ep":"S7 E9"},{"s":1795836300,"e":1795839000,"t":"Záchrana starých aut","st":"Cowbell Chevelle","d":"Derek a jeho bratr Sean se vracejí na rodinnou farmu v Severní Dakotě. Vyhrabou Chevrolet Chevelle sedan z roku (1971), který má podmáčený motor.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/8/883ad8a7ad681b68602d1417d2e12e24.jpg","ep":"S2 E7"},{"s":1795839000,"e":1795840500,"t":"Jak to dělají","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0d3fc664bfd2d1d8a5118e459b34e622.jpg","ep":"S15 E2"},{"s":1795840500,"e":1795842000,"t":"Jak to dělají","d":"K výrobě mnohých položek běžných v moderní společnosti jsou používány sofistikované inženýrské procesy. Jak vypadají.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0d3fc664bfd2d1d8a5118e459b34e622.jpg","ep":"S15 E3"},{"s":1795842000,"e":1795843800,"t":"Bizarní jídla: Lahodné destinace","st":"Birmingham","d":"Andrew odhalí pár jídel Birminghmau v Alabamě, která si musíte dát. Toto jižanské město opatruje duši klasických jídel jako sumec a smažené koule kukuřičné koule, grilovaná kuřata naložená v omáčce, křupavá smažená zelená raj.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cf4476553cf8aea9a8cf1dbb8a9f225d.jpg","ep":"S4 E7"},{"s":1795843800,"e":1795845600,"t":"Bizarní jídla: Lahodné destinace","st":"Ho Či Minovo Město","d":"Andrew odhalí kuchyni Ho Či Minova Města, od oblíbeného pouličních jídla tohoto města, šneků, po proslulé sendviče bahn mi. Rušné město také nabízí chutnou zlomkovou rýži, čerstvou krevetí polévku a křupavé jarní závitky.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cf4476553cf8aea9a8cf1dbb8a9f225d.jpg","ep":"S4 E12"},{"s":1795845600,"e":1795849200,"t":"Lovci odpadu","st":"Episode #14.17","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/08da0cb8a52f713c53ff34a1584aa12e.jpg","ep":"S14 E17"},{"s":1795849200,"e":1795851000,"t":"Jak se to dělá","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4eaac3db053c6306a0438a351827cabd.jpg","ep":"S13 E20"},{"s":1795851000,"e":1795852800,"t":"Jak se to dělá","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4eaac3db053c6306a0438a351827cabd.jpg","ep":"S13 E21"},{"s":1795852800,"e":1795856400,"t":"Výprava do neznáma","st":"America's Titanic","d":"Josh se potápí v Atlantiku a hledá miliony ve ztracených mincích potopených s americkým Titanikem. Nové snímky ze sonaru mohou vést k vraku.","c":["Dobrodružný","Mysteriozní"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/1/1a4e674906d29b76627160a01804e045.jpg","ep":"S9 E6"},{"s":1795856400,"e":1795857900,"t":"Schováno v kůlnách","st":"Rick Kenway","d":"Henry a Fuzz navštíví Richardovu garáž v Hooku plnou motocyklů, aut a kuriozit. K renovaci si vyberou klasický Harley-Davidson Sportster.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/5/5bec294075f3cb5b88622dc69c070c06.jpg","ep":"S7 E15"},{"s":1795857900,"e":1795860000,"t":"Schováno v kůlnách","st":"Dave McNicholas","d":"Henry a Fuzz zavítají do Daveovy garáže v Derby. Jako svůj další projekt si vyberou klasický Triumph Daytona, britskou ikonu se závodní tradicí.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/5/5bec294075f3cb5b88622dc69c070c06.jpg","ep":"S7 E16"},{"s":1795860000,"e":1795863300,"t":"Rození obchodníci","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/fb1c0003e85fb86b763f1c203a0b95d7.jpg","ep":"S18 E18"},{"s":1795863300,"e":1795866900,"t":"Záchrana starých aut","st":"Overtime Dually","d":"Derek a Dave Chappelle najdou na venkově v Kentucky mezi hejnem slepic starý pick-up s dvojitými zadními koly. Rozhodnou se jej proměnit v dílenský náklaďák na přepravu aut.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/8/883ad8a7ad681b68602d1417d2e12e24.jpg","ep":"S2 E4"},{"s":1795866900,"e":1795870800,"t":"Dynastie stavitelů náklaďáků","st":"Episode #1.4","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f86c631fac4c7faf0695a69f1524b5b3.jpg","ep":"S1 E4"},{"s":1795870800,"e":1795874100,"t":"Záchrana statku","st":"Trapped","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f48d43061b656264bdb3308f4ab23a5c.jpg","ep":"S2 E2"},{"s":1795874100,"e":1795878000,"t":"Záchrana statku","st":"Homestead of Horrors","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f48d43061b656264bdb3308f4ab23a5c.jpg","ep":"S2 E3"},{"s":1795878000,"e":1795881300,"t":"Aljaška: Poslední hranice","st":"New Frontiers, New Threats","d":"Po 80 letech na usedlosti rodina Kilcherů stále vzkvétá. Nyní představí zkušenosti, techniky a dovednosti, které získali, aby se jim dařilo.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/d/d20bb9079a6a6460c6d3d5b05d582069.jpg","ep":"S9 E1"},{"s":1795881300,"e":1795885200,"t":"Zlatá horečka","c":["Dokument","Western"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/9/9e1a0daab5bc86553bbeb965f115be5f.jpg","ep":"S11 E19"},{"s":1795885200,"e":1795886700,"t":"Hraniční kontrola: Polsko","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd8e2cbcd5a0610257b6e4b55e66b19a.jpg","ep":"S4 E5"},{"s":1795886700,"e":1795888500,"t":"Hraniční kontrola: Polsko","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd8e2cbcd5a0610257b6e4b55e66b19a.jpg","ep":"S4 E6"},{"s":1795888500,"e":1795890300,"t":"Hraniční kontrola: Polsko","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd8e2cbcd5a0610257b6e4b55e66b19a.jpg","ep":"S4 E7"},{"s":1795890300,"e":1795892400,"t":"Hraniční kontrola: Polsko","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd8e2cbcd5a0610257b6e4b55e66b19a.jpg","ep":"S4 E8"},{"s":1795892400,"e":1795895700,"t":"Poslední party: Smrt na ostrově Tresco","d":"Josh Clayton získal vysněnou práci na soukromém ostrově. Ale po divokém večírku zmizí a ostrov zachvátí panika.. Smrt mladého muže na soukromém ostrově vede k napínavému vyšetřování, přičemž rodina a přátelé se potýkají s mrazivou záhadou.","c":["Dokument","Krimi"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/3/3dacdfa2417c66d79bdd383b685622ed.jpg"},{"s":1795895700,"e":1795899300,"t":"Poslední party: Smrt na ostrově Tresco","d":"Josh Clayton získal vysněnou práci na soukromém ostrově. Ale po divokém večírku zmizí a ostrov zachvátí panika.. Smrt mladého muže na soukromém ostrově vede k napínavému vyšetřování, přičemž rodina a přátelé se potýkají s mrazivou záhadou.","c":["Dokument","Krimi"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/3/3dacdfa2417c66d79bdd383b685622ed.jpg"},{"s":1795899300,"e":1795902900,"t":"Než znovu zabijí","d":"Napodobitel vraha Zodiaca terorizuje New York. Zkušení detektivové newyorské policie ho musí přelstít a přijít na jeho identitu... Nikdo neví, kolik obětí sériový vrah zaměřený na lovce zabil. S blížící se další loveckou sezónou musí policie šílence najít... Vyjednavač je povolán k případu s rukojmím a musí zjistit, jak přemluvit střelce, aby složil zbraně, než začnou umírat lidé... Jedno městečko","c":["Dokument","Krimi"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/d/dd09f5e8bcc160b9e8cbcc8a43aedc66.jpg"},{"s":1795902900,"e":1795906500,"t":"Osobní kamery pro policii","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/a/a45712713979a7f6ac4a7bb1bdce929a.jpg"},{"s":1795906500,"e":1795909200,"t":"Lovci duchů","st":"Stranger in a Strange Land","c":["Drama","Pohádka"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/a/a852544df40c2423872493aa737b0ed7.jpg","ep":"S14 E1"},{"s":1795909200,"e":1795911900,"t":"Maso a krev","st":"Arizona Horror Story","c":["Dokument","Krimi"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0250a30f7b53e91139a4bdc0b35e24a4.jpg","ep":"S1 E1"},{"s":1795911900,"e":1795914600,"t":"Vybrala si mě vražda","st":"Too Close to Home","c":["Krimi"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4efc78d305984b67ff34aff896f34056.jpg","ep":"S3 E8"},{"s":1795914600,"e":1795917300,"t":"Vybrala si mě vražda","st":"Hollywood Boys","c":["Krimi"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd337806fdbb920a212b9b02c8d97991.jpg","ep":"S3 E9"},{"s":1795917300,"e":1795920000,"t":"Výprava do neznáma","st":"Cracking the Secret","d":"Josh Gates se vydává na celonárodní honbu za pokladem, aby vyřešil 40 let starou záhadu Tajemství.","c":["Dobrodružný","Mysteriozní"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/1/1a4e674906d29b76627160a01804e045.jpg","ep":"S7 E10"},{"s":1795920000,"e":1795922700,"t":"Záchrana starých aut","st":"Great 8n","d":"Derek si pro sebe najde traktor Ford 8N z roku (1950). Kvůli prasklému bloku motoru se však Derek bude muset vrátit ke svým cestám na farmy, aby traktor zprovoznil.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/8/883ad8a7ad681b68602d1417d2e12e24.jpg","ep":"S2 E8"},{"s":1795922700,"e":1795924200,"t":"Jak to dělají","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0d3fc664bfd2d1d8a5118e459b34e622.jpg","ep":"S15 E4"},{"s":1795924200,"e":1795925400,"t":"Jak to dělají","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0d3fc664bfd2d1d8a5118e459b34e622.jpg","ep":"S15 E5"},{"s":1795925400,"e":1795926900,"t":"Jak to dělají","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0d3fc664bfd2d1d8a5118e459b34e622.jpg","ep":"S15 E6"},{"s":1795926900,"e":1795928400,"t":"Jak to dělají","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0d3fc664bfd2d1d8a5118e459b34e622.jpg","ep":"S15 E7"},{"s":1795928400,"e":1795930200,"t":"Bizarní jídla: Lahodné destinace","st":"Pittsburgh","d":"Andrew prozkoumá oblíbená jídla Pittsburghu, domovského místa půllibrového rybího sendviče! Město pracující třídy stojí na chutných jídlech jako klobása, plněné zelí a pirohy, a pittsburghskou pýchou jsou hranolky jako příloha.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cf4476553cf8aea9a8cf1dbb8a9f225d.jpg","ep":"S4 E9"},{"s":1795930200,"e":1795932000,"t":"Bizarní jídla: Lahodné destinace","st":"Taipei","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cf4476553cf8aea9a8cf1dbb8a9f225d.jpg","ep":"S4 E10"},{"s":1795932000,"e":1795935600,"t":"Lovci odpadu","st":"Episode #14.18","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/08da0cb8a52f713c53ff34a1584aa12e.jpg","ep":"S14 E18"},{"s":1795935600,"e":1795937400,"t":"Jak se to dělá","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4eaac3db053c6306a0438a351827cabd.jpg","ep":"S13 E22"},{"s":1795937400,"e":1795939200,"t":"Jak se to dělá","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4eaac3db053c6306a0438a351827cabd.jpg","ep":"S13 E23"},{"s":1795939200,"e":1795942800,"t":"Výprava do neznáma","d":"Archeolog cestuje po celém světě a hledá neznámé a chybějící artefakty z celé doby. Josh Gates se snaží najít odpovědi na největší světové záhady. Má titul z archeologie a vášeň pro dobrodružství, a tak zkoumá nevyřešené příběhy po celém světě, odkrývá dávno ztracená města a pohřbené poklady. V první sérii Josh hledá hluboko v džunglích Kambodže ztracené město Khmérské říše, vydá se na cestu z Rus","c":["Dobrodružný","Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/1/1a4e674906d29b76627160a01804e045.jpg"},{"s":1795942800,"e":1795944300,"t":"Schováno v kůlnách","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/5/5bec294075f3cb5b88622dc69c070c06.jpg","ep":"S7 E17"},{"s":1795944300,"e":1795946400,"t":"Schováno v kůlnách","st":"Ollie Turney","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/5/5bec294075f3cb5b88622dc69c070c06.jpg","ep":"S7 E18"},{"s":1795946400,"e":1795949700,"t":"Rození obchodníci","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/fb1c0003e85fb86b763f1c203a0b95d7.jpg","ep":"S18 E19"},{"s":1795949700,"e":1795953300,"t":"Záchrana starých aut","st":"Hatchet Coronet","d":"Derek požádá Steva Dulcicha o renovaci opuštěného Dodge Coronet. Pánové však musí na tomto voze všechno vyměnit, pokud se chtějí dostat zpět do Nashvillu.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/8/883ad8a7ad681b68602d1417d2e12e24.jpg","ep":"S2 E5"},{"s":1795953300,"e":1795957200,"t":"Dynastie stavitelů náklaďáků","st":"Episode #1.5","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f86c631fac4c7faf0695a69f1524b5b3.jpg","ep":"S1 E5"},{"s":1795957200,"e":1795960500,"t":"Záchrana statku","st":"Honey I Torched the Homestead","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f48d43061b656264bdb3308f4ab23a5c.jpg","ep":"S2 E4"},{"s":1795960500,"e":1795964400,"t":"Záchrana statku","st":"Grizzly Bait","d":"Rodiny, které žijí mimo civilizace, se musí rychle učit. V zoufalé snaze zachránit své usedlosti požádají odborníky na přežití, aby je připravili na ty nejhorší nástrahy přírody.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/f/f48d43061b656264bdb3308f4ab23a5c.jpg","ep":"S2 E5"},{"s":1795964400,"e":1795967700,"t":"Aljaška: Poslední hranice","st":"Rusted and Busted","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/d/d20bb9079a6a6460c6d3d5b05d582069.jpg","ep":"S9 E2"},{"s":1795967700,"e":1795971600,"t":"Zlatá horečka","c":["Dokument","Western"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/9/9e1a0daab5bc86553bbeb965f115be5f.jpg","ep":"S11 E20"},{"s":1795971600,"e":1795973100,"t":"Hraniční kontrola: Polsko","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd8e2cbcd5a0610257b6e4b55e66b19a.jpg","ep":"S4 E9"},{"s":1795973100,"e":1795974900,"t":"Hraniční kontrola: Polsko","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd8e2cbcd5a0610257b6e4b55e66b19a.jpg","ep":"S4 E10"},{"s":1795974900,"e":1795976700,"t":"Hraniční kontrola: Polsko","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd8e2cbcd5a0610257b6e4b55e66b19a.jpg","ep":"S5 E1"},{"s":1795976700,"e":1795978800,"t":"Hraniční kontrola: Polsko","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cd8e2cbcd5a0610257b6e4b55e66b19a.jpg","ep":"S5 E2"},{"s":1795978800,"e":1795982400,"t":"Lovci odpadu","st":"History and provenance","d":"V yorkshirském panském sídle ze 13. století Drew nalezne vlajku s lékařským příběhem z období války. Kromě toho navštíví neogotický chrám v Edinburghu.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/08da0cb8a52f713c53ff34a1584aa12e.jpg","ep":"S11 E9"},{"s":1795982400,"e":1795986000,"t":"Načerno pálený alkohol","st":"Moonshine War","c":["Krimi","Drama"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/a/ac6542bed5b8fad8e48212266549c184.jpg","ep":"S3 E11"},{"s":1795986000,"e":1795992000,"t":"Nazí a vystrašení","c":["Dobrodružný","Horor"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/2/2a62f54b3cf3097889c463d16ea4dba9.jpg","ep":"S7 E16"},{"s":1795992000,"e":1795994700,"t":"Osobní kamery pro policii","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/a/a45712713979a7f6ac4a7bb1bdce929a.jpg"},{"s":1795994700,"e":1795997400,"t":"Lovci duchů","st":"Gods and Monsters","c":["Drama","Pohádka"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/a/a852544df40c2423872493aa737b0ed7.jpg","ep":"S14 E2"},{"s":1795997400,"e":1796000100,"t":"Maso a krev","st":"The Old-Fashioned Way","c":["Dokument","Krimi"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0250a30f7b53e91139a4bdc0b35e24a4.jpg","ep":"S1 E2"},{"s":1796000100,"e":1796002500,"t":"Vybrala si mě vražda","st":"The Man Behind the Mosque","c":["Krimi"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4efc78d305984b67ff34aff896f34056.jpg","ep":"S3 E10"},{"s":1796002500,"e":1796005200,"t":"Největší zlo","st":"Manson","c":["Dokument","Krimi"],"i":"https://www.sms.cz/~tri65dnigalerie/porad/600/4/480b18449e86bdebe430a98b7b8651c4.jpg","ep":"S3 E1"},{"s":1796005200,"e":1796007900,"t":"Výprava do neznáma","st":"Gold Rush of the Atlantic","d":"Josh Gates má novou stopu po obrovském ztraceném pokladu ztroskotané španělské flotily z roku 1715.","c":["Dobrodružný","Mysteriozní"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/1/1a4e674906d29b76627160a01804e045.jpg","ep":"S7 E11"},{"s":1796007900,"e":1796010600,"t":"Záchrana starých aut","st":"Disaster Deluxe","d":"Derek najde Chevrolet Deluxe z roku (1937), který už 20 let nejezdil. Zvládne 150 mil dlouhou cestu do centrály General Motors v Detroitu.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/8/883ad8a7ad681b68602d1417d2e12e24.jpg","ep":"S2 E9"},{"s":1796010600,"e":1796012100,"t":"Jak to dělají","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0d3fc664bfd2d1d8a5118e459b34e622.jpg","ep":"S15 E8"},{"s":1796012100,"e":1796013300,"t":"Jak to dělají","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0d3fc664bfd2d1d8a5118e459b34e622.jpg","ep":"S15 E9"},{"s":1796013300,"e":1796015100,"t":"Jak to dělají","d":"Výroba předmětů denní potřeby se v moderní společnosti opírá o sofistikované inženýrské procesy. Jak probíhají.","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/0d3fc664bfd2d1d8a5118e459b34e622.jpg","ep":"S15 E10"},{"s":1796015100,"e":1796016600,"t":"Bizarní jídla: Lahodné destinace","st":"Cajun Country","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cf4476553cf8aea9a8cf1dbb8a9f225d.jpg","ep":"S4 E11"},{"s":1796016600,"e":1796018400,"t":"Bizarní jídla: Lahodné destinace","st":"Ho Či Minovo Město","d":"Andrew odhalí kuchyni Ho Či Minova Města, od oblíbeného pouličních jídla tohoto města, šneků, po proslulé sendviče bahn mi. Rušné město také nabízí chutnou zlomkovou rýži, čerstvou krevetí polévku a křupavé jarní závitky.","i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/c/cf4476553cf8aea9a8cf1dbb8a9f225d.jpg","ep":"S4 E12"},{"s":1796018400,"e":1796022000,"t":"Lovci odpadu","st":"Episode #14.19","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/0/08da0cb8a52f713c53ff34a1584aa12e.jpg","ep":"S14 E19"},{"s":1796022000,"e":1796023800,"t":"Jak se to dělá","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4eaac3db053c6306a0438a351827cabd.jpg","ep":"S13 E24"},{"s":1796023800,"e":1796025600,"t":"Jak se to dělá","c":["Dokument"],"i":"https://www.sms.cz/~tri65dnigalerie/porad_booklet/600/4/4eaac3db053c6306a0438a351827cabd.jpg","ep":"S13 E25"},{"s":1796025600,"e":1796029200,"t":"Výprava do neznáma","d":"Archeolog cestuje po celém světě a hledá neznámé a chybějící artefakty z celé doby. Josh Gates se snaží najít odpovědi na největší světové záhady. Má titul z archeologie a