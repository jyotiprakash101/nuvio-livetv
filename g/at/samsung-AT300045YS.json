an.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1629542681_0_20260216T131330802Z_144_imageprocessorclient-tvplus-linear-85d7d49859-sxbhs.jpeg"},{"s":1795305553,"e":1795309541,"t":"Poldark","st":"S02 E08","d":"Ross und Dwight werden wegen Schmuggels vor Gericht gestellt.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1629534751_0_20260216T131321841Z_132_imageprocessorclient-tvplus-linear-85d7d49859-sxbhs.jpeg"}]