[{"s":1795283987,"e":1795287140,"t":"El-Daly S1 E31","d":"Abu Al-Mahasen flieht vor Khaleds Männern und gesteht.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQO570425A_1932589895_0_20260614T181436622Z_80_imageprocessorclient-tvplus-linear-66fc4d58c8-9pcd8.jpeg"},{"s":1795287140,"e":1795290264,"t":"El-Daly S1 E32","d":"Sa'd deckt Khaleds Ehe auf und besiegt seine Rivalen.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQO570425A_1932599361_0_20260614T181436622Z_65_imageprocessorclient-tvplus-linear-66fc4d58c8-9pcd8.jpeg"},{"s":1795290264,"e":1795293392,"t":"El-Daly S1 E33","d":"Sa'ds Rivalen gehen unter. Refky warnt ihn rechtzeitig.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQO570425A_1950252694_0_20260621T091036527Z_1_imageprocessorclient-tvplus-linear-66fc4d58c8-mrkj2.jpeg"},{"s":1795293392,"e":1795296059,"t":"Wesh Tany S1 E28","d":"Salem bittet Sayed, seine vermisste Tochter zu finden.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQO570425A_2237062779_0_20260928T211438409Z_144_imageprocessorclient-tvplus-linear-b5879c6c6-n9nsv.jpeg"},{"s":1795296059,"e":1795299293,"t":"Wesh Tany S1 E29","d":"Sayeds Vater wird krank. Zubaida bringt El-Doksh um.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQO570425A_2237067886_0_20260928T211438393Z_98_imageprocessorclient-tvplus-linear-b5879c6c6-n9nsv.jpeg"},{"s":1795299293,"e":1795302786,"t":"Wesh Tany S1 E30","d":"Sayed bringt die Wachen zusammen, um sich zu rächen.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQO570425A_2237072597_0_20260928T211438386Z_95_imageprocessorclient-tvplus-linear-b5879c6c6-n9nsv.jpeg"},{"s":1795302786,"e":1795305890,"t":"El-Daly S1 E28","d":"Abu Al-Naga erzählt Sa'd, der Verräter sei in seiner Nähe.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQO570425A_1932599366_0_20260614T181436622Z_106_imageprocessorclient-tvplus-linear-66fc4d58c8-9pcd8.jpeg"},{"s":1795305890,"e":1795308873,"t":"El-Daly S1 E29","d":"Die Mafia droht Sa'd wegen seiner Memoiren. Er stoppt das Buch.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQO570425A_1932581458_0_20260614T181436622Z_46_imageprocessorclient-tvplus-linear-66fc4d58c8-9pcd8.jpeg"}]