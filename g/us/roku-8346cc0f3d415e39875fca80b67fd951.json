ku.com/idType/roku-trc/context/trc/id/d9c0ef20c12958b38805e59d4cbef9cc/images/gracenote/assets/p423726_b_h10_ab.jpg","ep":"S01E19"},{"s":1795508160,"e":1795511460,"t":"Laramie","st":"Laramie","d":"Passengers of a stagecoach, waiting out a storm at the ranch, have something to hide.","i":"https://images.sr.roku.com/idType/roku-trc/context/trc/id/d9c0ef20c12958b38805e59d4cbef9cc/images/gracenote/assets/p423726_b_h10_ab.jpg","ep":"S01E20"},{"s":1795511460,"e":1795514820,"t":"Laramie","st":"Laramie","d":"The new stage line superintendent wants Jess fired; Slim and Jess track horse thieves.","i":"https://images.sr.roku.com/idType/roku-trc/context/trc/id/d9c0ef20c12958b38805e59d4cbef9cc/images/gracenote/assets/p423726_b_h10_ab.jpg","ep":"S01E21"},{"s":1795514820,"e":1795516440,"t":"Tales of Wells Fargo","st":"Tales of Wells Fargo","d":"Hardie tries to find a prisoner's hidden loot.","i":"https://images.sr.roku.com/idType/roku-trc/context/trc/id/3b218c0cede0516bb1d1394fea9e3e8d/rokuFeed/assets/50daf8b658aa5dadbfce016456a14864.jpg","ep":"S02E18"},{"s":1795516440,"e":1795518120,"t":"Tales of Wells Fargo","st":"Tales of Wells Fargo","d":"Jim protects a woman who is a material witness in a San Francisco corruption investigation.","i":"https://images.sr.roku.com/idType/roku-trc/context/trc/id/3b218c0cede0516bb1d1394fea9e3e8d/rokuFeed/assets/50daf8b658aa5dadbfce016456a14864.jpg","ep":"S02E19"},{"s":1795518120,"e":1795519800,"t":"Tales of Wells Fargo","st":"Tales of Wells Fargo","d":"A young man helps Jim investigate a robbery.","i":"https://images.sr.roku.com/idType/roku-trc/context/trc/id/3b218c0cede0516bb1d1394fea9e3e8d/rokuFeed/assets/50daf8b658aa5dadbfce016456a14864.jpg","ep":"S02E20"},{"s":1795519800,"e":1795521480,"t":"Tales of Wells Fargo","st":"Tales of Wells Fargo","d":"Hardie attempts to break up a gang of outlaws that steals buffalo hides.","i":"https://images.sr.roku.com/idType/roku-trc/context/trc/id/3b218c0cede0516bb1d1394fea9e3e8d/rokuFeed/assets/50daf8b658aa5dadb