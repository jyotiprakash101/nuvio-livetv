[{"s":1795284000,"e":1795287600,"t":"Gene Roddenberry's Andromeda","st":"Double or Nothingness","d":"Dylan is kidnapped by Nietscheans and forced to play mind games for the amusement of his captors.","c":["Science fiction","Series","Action"],"i":"https://images.pluto.tv/series/5ea2fb910fa6a5001a70d811/tile_1781206922445.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E04"},{"s":1795287600,"e":1795291200,"t":"Gene Roddenberry's Andromeda","st":"Harper/Delete","d":"Two Nietzschean siblings are in a stand-off over a weapon that can eliminate higher brain functions. The crew steps in so neither can get the weapon.","c":["Science fiction","Series","Action"],"i":"https://images.pluto.tv/series/5ea2fb910fa6a5001a70d811/tile_1781206922445.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E05"},{"s":1795291200,"e":1795294800,"t":"Gene Roddenberry's Andromeda","st":"Soon the Nearing Vortex","d":"Tyr returns, having joined with the Collectors and demanding the Route of Ages from his former crewmates.","c":["Science fiction","Series","Action"],"i":"https://images.pluto.tv/series/5ea2fb910fa6a5001a70d811/tile_1781206922445.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E06"},{"s":1795294800,"e":1795298400,"t":"Gene Roddenberry's Andromeda","st":"The World Turns All Around Her","d":"A hostage situation ensues when the crew confronts Tyr. Beka is rescued, Tyr is killed, and Trance reveals her true nature.","c":["Science fiction","Series","Action"],"i":"https://images.pluto.tv/series/5ea2fb910fa6a5001a70d811/tile_1781206922445.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E07"},{"s":1795298400,"e":1795302000,"t":"Gene Roddenberry's Andromeda","st":"Conduit to Destiny","d":"A wrong turn in the slipstream leads Andromeda to a prison riot. When the dust settles, they discover a prisoner missing.","c":["Science fiction","Series","Action"],"i":"https://images.pluto.tv/series/5ea2fb910fa6a5001a70d811/tile_1781206922445.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E08"},{"s":1795302000,"e":1795305600,"t":"Gene Roddenberry's Andromeda","st":"Machinery of the Mind","d":"The Andromeda crew steps up to find out who killed a group of scientists and locate the kidnapped one.","c":["Science fiction","Series","Action"],"i":"https://images.pluto.tv/series/5ea2fb910fa6a5001a70d811/tile_1781206922445.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E09"},{"s":1795305600,"e":1795309200,"t":"Gene Roddenberry's Andromeda","st":"Exalted Reason, Resplendent Daughter","d":"The crew is hired to rescue a princess from a notorious outlaw, but it is soon revealed that she was trying to escape murder at her father's hand.","c":["Science fiction","Series","Action"],"i":"https://images.pluto.tv/series/5ea2fb910fa6a5001a70d811/tile_1781206922445.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E10"},{"s":1795309200,"e":1795312800,"t":"Gene Roddenberry's Andromeda","st":"The Torment, the Release","d":"The Collectors now control the Commonwealth and put the Andromeda crew on trial.","c":["Science fiction","Series","Action"],"i":"https://images.pluto.tv/series/5ea2fb910fa6a5001a70d811/tile_1781206922445.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E11"},{"s":1795312800,"e":1795316400,"t":"Gene Roddenberry's Andromeda","st":"The Spider's Stratagem","d":"Andromeda discovers a shipment of bio-armor, with terrifying results.","c":["Science fiction","Series","Action"],"i":"https://images.pluto.tv/series/5ea2fb910fa6a5001a70d811/tile_1781206922445.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E12"},{"s":1795316400,"e":1795320000,"t":"Gene Roddenberry's Andromeda","st":"The Warmth of an Invisible Light","d":"An experimental cloaking device drops Dylan in an alternate universe, where he learns how to save the Andromeda - assuming he can get back to his own reality.","c":["Science fiction","Series","Action"],"i":"https://images.pluto.tv/series/5ea2fb910fa6a5001a70d811/tile_1781206922445.jpg?fill=blu