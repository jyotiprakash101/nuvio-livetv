[{"s":1795846394,"e":1795850812,"t":"Kitabwala","d":"In this episode of Kitabwala, Kuldeep Mishra sits with engineer and author Krish Ashok to explore the science behind everyday food beliefs, decoding myths about ghee, refined flour, and rice. The conversation is based on Ashok's book Masala Body.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IN_USQT620324A_2379423885_0_20260105T115851758Z_1_imageprocessorclient-tvplus-linear-584c967455-ndmb8.jpeg"},{"s":1795850812,"e":1795852563,"t":"LT Insider","d":"Vikas Verma of The Lallantop speaks to Rohit Bansal, Founder and CEO of AQI.in, about why government monitoring stations and private air-quality platforms show vastly different pollution numbers, and what really happens on Diwali night when readings reportedly spike to 2,000–3,000.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IN_USQT620324A_2379423885_0_20260105T115851758Z_1_imageprocessorclient-tvplus-linear-584c967455-ndmb8.jpeg"},{"s":1795852563,"e":1795855995,"t":"Guest In The Newsroom","d":"Veteran actor Raza Murad joins Guest In The Newsroom for a candid conversation about Bollywood, sharing untold stories about legends like Rajesh Khanna, Dilip Kumar, and Rajkumar, as well as his take on Shah Rukh Khan, Salman Khan, Ranveer Singh, and Ranbir Kapoor.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IN_USQT620324A_2379423885_0_20260105T115851758Z_1_imageprocessorclient-tvplus-linear-584c967455-ndmb8.jpeg"},{"s":1795855995,"e":1795857900,"t":"The Lallantop","st":"Show","d":"The Lallantop","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IN_USQT620324A_2379423885_0_20260105T115851758Z_1_imageprocessorclient-tvplus-linear-584c967455-ndmb8.jpeg"},{"s":1795857900,"e":1795859383,"t":"Duniyadari","d":"The Lallantop","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IN_USQT620324A_2379423885_0_20260105T115851758Z_1_imag