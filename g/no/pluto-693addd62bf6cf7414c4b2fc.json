[{"s":1795845483,"e":1795849180,"t":"Star Trek: The Original Series","st":"The Naked Time","d":"A strange alien substance causes the crew to act out their deepest inhibitions, while the ship plummets out of orbit.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/6969f419b9f75c652f696d66/tile_1776461041376.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E04"},{"s":1795849180,"e":1795852874,"t":"Star Trek: The Original Series","st":"The Enemy Within","d":"A transporter malfunction causes Captain Kirk to split into his \"good\" and \"evil\" selves, and a landing party will freeze to death if the crew is unable to find a way to merge the two Kirks back together.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/6969f419b9f75c652f696d66/tile_1776461041376.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E05"},{"s":1795852874,"e":1795856567,"t":"Star Trek: The Original Series","st":"Mudd's Women","d":"The Enterprise picks up a intergalactic conman, Harry Mudd, and three incredibly beautiful women who harbor a dark secret.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/6969f419b9f75c652f696d66/tile_1776461041376.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E06"},{"s":1795856567,"e":1795860262,"t":"Star Trek: The Original Series","st":"What Are Little Girls Made Of?","d":"Nurse Christine Chapel is reunited with her old fiancé on Exo III, but the scientist has plans for Captain Kirk and the Federation.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/6969f419b9f75c652f696d66/tile_1776461041376.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E07"},{"s":1795860262,"e":1795863956,"t":"Star Trek: The Original Series","st":"Miri","d":"A strange group of children are discovered on an Earth-like planet.","c":["Science fiction","Series","Adventure"],"i":"https://images.pluto.tv/series/6969f419b9f75c652f696d66/tile_