ome.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3119f694b001375a44a/tile_1767674965509.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E07"},{"s":1795329917,"e":1795333037,"t":"Star Trek: Voyager: Retroaktiv virkning","st":"Retroaktiv virkning","d":"After Paris is convicted of a murder he swears he didn't commit, Tuvok must play detective to clear him.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3119f694b001375a44a/tile_1767674965509.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E08"},{"s":1795333037,"e":1795336157,"t":"Star Trek: Voyager: Utstråling","st":"Utstråling","d":"Kim confronts life and death issues when he's held against his will by an alien race.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3119f694b001375a44a/tile_1767674965509.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E09"},{"s":1795336157,"e":1795339277,"t":"Star Trek: Voyager: Hovedfaktorer","st":"Hovedfaktorer","d":"An alien leader has the technology that could send the crew 40,000 light years closer to home -- but refuses to share it with them.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3119f694b001375a44a/tile_1767674965509.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E10"},{"s":1795339277,"e":1795342397,"t":"Star Trek: Voyager: Forandringstadie","st":"Forandringstadie","d":"The crew realizes there's a traitor on board after Federation technology turns upon an enemy warship.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3119f694b001375a44a/tile_1767674965509.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E11"}]