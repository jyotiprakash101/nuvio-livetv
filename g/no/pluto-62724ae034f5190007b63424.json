[{"s":1795282445,"e":1795285822,"t":"Doc Martin: Episode 102","st":"Episode 102","d":"Martins første arbeidsdag kan også bli hans siste.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E02"},{"s":1795285822,"e":1795289205,"t":"Doc Martin: Episode 103","st":"Episode 103","d":"En diaréepidemi rammer byen og Martin tar umiddelbart grep.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E03"},{"s":1795289205,"e":1795292599,"t":"Doc Martin: Episode 104","st":"Episode 104","d":"Martin drar på hjemmebesøk til en skogvokter som deler sitt hjem med et gigantisk ekorn.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E04"},{"s":1795292599,"e":1795295987,"t":"Doc Martin: Episode 105","st":"Episode 105","d":"En gammel venn av Joan dukker opp og vekker gamle minner.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E05"},{"s":1795295987,"e":1795299385,"t":"Doc Martin: Episode 106","st":"Episode 106","d":"Ryktene om legens \"lille\" problem med blod sirkulerer i landsbyen. Peter Cronk er skadet og bekymringen for hans helse bringer Martin og Louisa nærmere hverandre.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E06"},{"s":1795299385,"e":1795302716,"t":"Doc Martin: Episode 201","st":"Episode 201","d":"Louisas gamle flamme, Danny Steel, kommer til Portwenn i håp om å gjenopplive romansen deres.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E01"},{"s":1795302716,"e":1795306089,"t":"Doc Martin: Episode 202","st":"Episode 202","d":"Når moren hans må på sykehus, trenger Peter Cronk et sted å bo.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E02"},{"s":1795306089,"e":1795309474,"t":"Doc Martin: Episode 203","st":"Episode 203","d":"Al oppdager at Bert ikke er hans biologiske far.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E03"},{"s":1795309474,"e":1795312850,"t":"Doc Martin: Episode 204","st":"Episode 204","d":"En gammel mann som har en uforklarlig stank, konsulterer doktor Ellingham; og den lokale radioverten, Caroline, har et alvorlig drikkeproblem.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E04"},{"s":1795312850,"e":1795316233,"t":"Doc Martin: Episode 205","st":"Episode 205","d":"Martin undersøker Helen Pratt, men hun kollapser og dør. Mannen hennes, Phil, er sint på legen og gir ham skylden for konas død.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E05"},{"s":1795316233,"e":1795319602,"t":"Doc Martin: Episode 206","st":"Episode 206","d":"Martins vanskelige foreldre kommer for å bo hos ham. Han har ikke sett dem på syv år, og er forvirret over hvorfor de plutselig skulle dukke opp nå.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E06"},{"s":1795319602,"e":1795322990,"t":"Doc Martin: Episode 207","st":"Episode 207","d":"Mark Mylow planlegger å tilbringe sitt utdrikningslag i skogen med Al Large, men han blir bitt av en huggorm.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E07"},{"s":1795322990,"e":1795326510,"t":"Doc Martin: Episode 208","st":"Episode 208","d":"Et medlem av Frelsesarmeen kommer til Portwenn for å prøve å finne en savnet kvinne. Danny ber sin motvillige kjæreste Louisa om flytte inn hos ham.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E08"},{"s":1795326510,"e":1795329870,"t":"Doc Martin: Episode 301","st":"Episode 301","d":"Martin mistenker at Louisa kan ha anemi. Tante Joan blir tvunget til å motta behandling fra Martin etter at hun nesten kjørte på noen.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E01"},{"s":1795329870,"e":1795333199,"t":"Doc Martin: Episode 302","st":"Episode 302","d":"Bert Large forlater rørleggerfirmaet sitt til fordel for å drive en restaurant. Etter restaurantens åpning forekommer det flere tilfeller av matforgiftning.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E02"},{"s":1795333199,"e":1795336528,"t":"Doc Martin: Episode 303","st":"Episode 303","d":"Et par og sønnen deres flytter inn ved siden av Louisa og skaper problemer for henne, Martin og lokalbefolkningen. Beboere begynner også å oppdage noe uvanlig med PC Penhale.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E03"},{"s":1795336528,"e":1795339895,"t":"Doc Martin: Episode 304","st":"Episode 304","d":"Fru Wilson, den hypokondriske eieren av Wilson-hotellet, vier all sin oppmerksomhet til Martin, noe som fører til at Louisa blir sjalu.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E04"},{"s":1795339895,"e":1795343250,"t":"Doc Martin: Episode 305","st":"Episode 305","d":"Paulines spilleavhengighet kommer endelig fram i lyset.","c":["Series","Inspirational Drama","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E05"}]